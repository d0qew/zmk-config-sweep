#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        ht: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <220>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <100>;
            bindings = <&kp>, <&kp>;
        };

        hrm: hrm {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    combos {
        compatible = "zmk,combos";

        bootloader-left {
            bindings = <&bootloader>;
            key-positions = <0 1 2>;
        };

        bootloader-right {
            bindings = <&bootloader>;
            key-positions = <9 8 7>;
        };

        b {
            bindings = <&bt BT_CLR_ALL>;
            key-positions = <20 21 22>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q  &kp W  &kp E  &kp R  &kp T        &kp Y            &kp U  &kp I      &kp O    &kp P
&kp A  &kp S  &kp D  &kp F  &kp G        &kp H            &kp J  &kp K      &kp L    &kp SEMICOLON
&kp Z  &kp X  &kp C  &kp V  &kp B        &kp N            &kp M  &kp COMMA  &kp DOT  &kp FSLH
                     &mo 1  &kp SPACE    &kp RIGHT_SHIFT  &sl 2
            >;
        };

        nums+symbols {
            bindings = <
&kp NUMBER_1    &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4    &kp NUMBER_5        &kp NUMBER_6       &kp NUMBER_7     &kp NUMBER_8  &kp NUMBER_9          &kp NUMBER_0
&kp EXCL        &kp AT        &kp HASH      &kp DOLLAR      &kp PERCENT         &kp CARET          &kp AMPERSAND    &kp STAR      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp APOSTROPHE  &kp PIPE      &kp PLUS      &kp LEFT_BRACE  &kp LEFT_BRACKET    &kp RIGHT_BRACKET  &kp RIGHT_BRACE  &kp EQUAL     &kp BACKSLASH         &kp DOUBLE_QUOTES
                                            &trans          &trans              &kp BACKSPACE      &kp ENTER
            >;
        };

        arrows+special {
            bindings = <
&trans  &trans        &trans        &trans            &trans        &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &mo 3
&trans  &kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp MINUS     &kp UNDERSCORE        &kp RIGHT_CONTROL     &kp RIGHT_ALT      &kp RIGHT_GUI    &trans
&trans  &trans        &kp TILDE     &kp GRAVE         &trans        &kp LEFT_ARROW        &kp DOWN_ARROW        &kp UP_ARROW       &kp RIGHT_ARROW  &trans
                                    &kp TAB           &kp ESCAPE    &trans                &trans
            >;
        };

        bluetooth {
            bindings = <
&bt BT_CLR_ALL  &bt BT_SEL 0  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &sys_reset
&trans          &trans        &trans  &trans  &trans    &trans  &trans  &trans  &trans  &bootloader
&trans          &trans        &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
                                      &trans  &to 0     &trans  &trans
            >;
        };
    };
};
